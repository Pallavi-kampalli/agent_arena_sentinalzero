# SentinelZero — AI Cyber Detective Participant Configuration

# Runtime Mode ('submission' for live arena platform, 'practice' for offline mock simulator)
MODE=submission

# Practice Mode (Local Mock Simulator: http://127.0.0.1:8001)
PRACTICE_ARENA_URL=http://127.0.0.1:8001
PRACTICE_BEARER_TOKEN=dev-practice-token

# Submission Mode (Live Competition Arena: public ngrok ingress or http://localhost:8000)
SUBMISSION_ARENA_URL=https://plentiful-approve-prompter.ngrok-free.dev
SUBMISSION_BEARER_TOKEN=your-assigned-team-bearer-token

# Google Gemini API Keys (define up to 10 keys for automatic round-robin rotation across tasks)
GOOGLE_API_KEY_1=your_google_api_key_1
GOOGLE_API_KEY_2=your_google_api_key_2
GOOGLE_API_KEY_3=your_google_api_key_3
GOOGLE_API_KEY_4=your_google_api_key_4
GOOGLE_API_KEY_5=your_google_api_key_5

# Google Gemini Model & Endpoint Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
# Custom Base URL / Gateway (optional, leave commented to use official Google API endpoint)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
