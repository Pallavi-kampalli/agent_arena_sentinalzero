# ==============================================================================
# Agent Arena — SupportOps Environment Configuration
# ==============================================================================
# NOTE: In production (ENVIRONMENT=production), secrets must be high-entropy
# strings (>= 32 characters) and cannot contain insecure placeholder words.

# Primary PostgreSQL Connection URL
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@127.0.0.1:5432/agent_arena

# Administrative Control Panel Authentication Secret (min 32 chars)
ADMIN_PANEL_SECRET=change-this-production-admin-secret-key-32-chars-min-entropy

# Participant JWT Signing Secret (min 32 chars)
JWT_SIGNING_SECRET=change-this-production-jwt-secret-key-32-chars-min-entropy

# Deployment Environment ('production' enforces fail-closed secret validation)
ENVIRONMENT=staging

# HTTP Server Port
PORT=8000

# CORS Allowed Origins (comma-separated list of domains, or '*' in staging/dev only)
CORS_ORIGINS=*

# Allowed Host Headers (comma-separated list of hostnames, or '*' in staging/dev only)
ALLOWED_HOSTS=*

# Ground Truth Practice Reveal (MUST be false in production)
REVEAL_GROUND_TRUTH=false

# Application Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
